# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_chat_id

# ── Mostaql Credentials (for authenticated scraping) ─
MOSTAQL_EMAIL=your_email@example.com
MOSTAQL_PASSWORD=your_mostaql_password

# ── Gemini AI ────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Bot Behaviour ────────────────────────────────
POLL_INTERVAL_SECONDS=30       # How often to check for new jobs (min 30)
MOSTAQL_CATEGORY_ID=1          # 1 = Programming & Web Dev

# ── Base Proposal Prompt ─────────────────────────
# Write your skills, experience, and tone here.
# The AI will use this as the foundation for every proposal.
BASE_PROPOSAL_PROMPT="أنا مطور Full-Stack بخبرة في Python وJavaScript وReact وNode.js..."
